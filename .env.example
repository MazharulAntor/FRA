LLM_PROVIDER=anthropic          # anthropic | openai | openrouter | lmstudio | ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=claude-sonnet-4-5     # or gpt-4o-mini, llama3.1, etc.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./.chroma
UPLOAD_DIR=./uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=8
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173
